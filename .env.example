# Web login is configured on first launch or with Configure Login.bat.
# Only the username and one-way password hash are stored; there is no website setting.
# VISIONGATE_USERNAME=admin
# VISIONGATE_PASSWORD_HASH=scrypt$...
# Session idle/absolute timeouts default to 30 minutes / 8 hours.
VISIONGATE_SESSION_IDLE_SECONDS=1800
VISIONGATE_SESSION_LIFETIME_SECONDS=28800
# Set to 1 only when VisionGate is served over HTTPS.
VISIONGATE_SECURE_COOKIES=0
# Configure Online Access.bat sets these when HTTPS is enabled.
# VISIONGATE_PUBLIC_HOST=door.example.com
# VISIONGATE_ALLOWED_HOSTS=door.example.com

# Optional first-run defaults. After first launch, edit device settings in the app.
# RTSP_URL is optional because app.py also imports info.md on first run.
# RTSP_URL=rtsp://user:password@camera.local:554/path

# Optional direct eWeLink LAN defaults. Configure these in the app instead.
EWELINK_MODEL=SONOFF 4CH Pro R2
# EWELINK_HOST=192.168.2.60
EWELINK_PORT=8081
# EWELINK_DEVICE_ID=1000xxxxxxxx
# EWELINK_DEVICE_KEY=replace-with-device-key
EWELINK_OPEN_CHANNEL=1
EWELINK_CLOSE_CHANNEL=2

# Door relays should never be left energized. Match this to hardware inching.
DOOR_PULSE_SECONDS=1
# Close this many seconds after the last authorized target leaves. Set 0 to disable.
AUTO_CLOSE_SECONDS=5

# Calibrate these on the real camera. Raise threshold/confirmations to reduce false accepts.
MATCH_THRESHOLD=0.82
MATCH_MARGIN=0.04
MATCH_CONFIRMATIONS=3
OPEN_COOLDOWN_SECONDS=20
DETECTION_CONFIDENCE=0.35
EMBED_EVERY=5
YOLO_MODEL=yolo11n.pt
YOLO_IMGSZ=640
JPEG_QUALITY=82
